# Copy this file to .env.local for local development (never commit real secrets).
# Browser smoke-test credentials live separately in .env.smoke.local (see .env.smoke.example).

# ------------------------------------------------------------------------------
# Client (Vite / Browser — public only; NEVER place secrets in VITE_* variables)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional rollback switch for durable shopping list creates (defaults to true)
VITE_SHOPPING_DURABLE_CREATES=true

# ------------------------------------------------------------------------------
# Server (api/ Vercel serverless functions — server-only)
# ------------------------------------------------------------------------------
# Optional server overrides; fall back to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Required by api/ endpoints (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Canonical app origin used for API CORS allowlists and Stripe redirects
NEXT_PUBLIC_APP_URL=https://pmworkspace.com

# Stripe billing & webhook verification
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional AI & nutrition provider keys
PLATFORM_AI_KEY=
# Falls back to DEMO_KEY / starter catalog / DB cache when unset
USDA_FDC_API_KEY=

# Optional Web Push (VAPID) credentials for background shopping notifications
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=privacy@pmworkspace.com
