    "decisions": [
      { "_id": "decision_1", "number": 1, "visible": true, "public": true, "decision": "Use dual underlays at all sites, with Ethernet or broadband primary and diverse broadband or LTE secondary.", "decidedby": "Design Authority", "dateraised": "2026-08-04", "datedecided": "2026-08-11", "rationale": "Provides resilient path diversity without retaining full MPLS cost.", "impact": "Circuit orders and failover testing must cover both paths.", "status": "Approved" },
      { "_id": "decision_2", "number": 2, "visible": true, "public": true, "decision": "Use London HQ and Manchester branch as pilot sites.", "decidedby": "Programme Board", "dateraised": "2026-08-04", "datedecided": "2026-08-11", "rationale": "Covers a complex headquarters and a representative branch pattern.", "impact": "Pilot preparation focuses on these two sites.", "status": "Approved" },
      { "_id": "decision_3", "number": 3, "visible": true, "public": true, "decision": "Create separate PCI, corporate, voice, guest and management VPN segments.", "decidedby": "Security Working Group", "dateraised": "2026-08-12", "datedecided": "", "rationale": "Aligns security zones with compliance and operational boundaries.", "impact": "Requires firewall, routing and monitoring policy per segment.", "status": "Proposed" },
      { "_id": "decision_4", "number": 4, "visible": true, "public": true, "decision": "Retain legacy MPLS for five business days after each migration wave.", "decidedby": "Network Service Owner", "dateraised": "2026-08-13", "datedecided": "2026-08-18", "rationale": "Provides a controlled rollback option during early-life support.", "impact": "Carrier cease dates must follow wave acceptance.", "status": "Approved" },
      { "_id": "decision_5", "number": 5, "visible": true, "public": false, "decision": "Use LTE temporarily where secondary fixed circuits miss pilot or wave dates.", "decidedby": "Programme Sponsor", "dateraised": "2026-08-17", "datedecided": "2026-08-18", "rationale": "Protects the baseline while preserving path resilience.", "impact": "Adds temporary monthly charge and requires LTE signal validation.", "status": "Approved" }
